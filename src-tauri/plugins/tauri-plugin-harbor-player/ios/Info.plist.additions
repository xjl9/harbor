<!-- NOT a standalone plist. MERGE these keys into the top-level <dict> of
     src-tauri/gen/apple/<App>_iOS/Info.plist AFTER running `tauri ios init` on the
     Mac. Do NOT replace the generated Info.plist. SwiftPM ignores this file. -->

<!-- Background audio: keep playback alive when the screen locks / app backgrounds.
     Required for AVAudioSession .playback and Picture in Picture. -->
<key>UIBackgroundModes</key>
<array>
  <string>audio</string>
</array>

<!-- App Transport Security: librqbit serves torrent data over http://127.0.0.1.
     NSAllowsLocalNetworking permits loopback / localhost / *.local cleartext
     without weakening ATS for remote HTTPS (Torrentio / debrid). Loopback does NOT
     trigger the iOS 14+ Local Network privacy prompt, so no usage-description key
     is needed. -->
<key>NSAppTransportSecurity</key>
<dict>
  <key>NSAllowsLocalNetworking</key>
  <true/>
</dict>

<!-- Player needs landscape; keep portrait for the shell UI. -->
<key>UISupportedInterfaceOrientations</key>
<array>
  <string>UIInterfaceOrientationPortrait</string>
  <string>UIInterfaceOrientationLandscapeLeft</string>
  <string>UIInterfaceOrientationLandscapeRight</string>
</array>
